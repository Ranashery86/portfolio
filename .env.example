# Public site URL used for metadata, canonical URLs, sitemap, and robots
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Booking link used by call-to-action buttons
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro-call

# Web3Forms access key for the contact form
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Optional: send contact submissions to an n8n webhook instead of Web3Forms
N8N_WEBHOOK_URL=
