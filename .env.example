# Public site URL used for metadata, canonical URLs, sitemap, and robots
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Booking link used by call-to-action buttons
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/shaheermdssr/30min

# Server-only: n8n contact form webhook
N8N_CONTACT_WEBHOOK_URL=https://xawomac.app.n8n.cloud/webhook/portfolio-contact

# Server-only: n8n voice agent webhook
N8N_VOICE_WEBHOOK_URL= https://xawomac.app.n8n.cloud/webhook/portfolio-voice-agent

# Server-only: HTTP header name used to send the voice webhook secret
VOICE_WEBHOOK_HEADER_NAME=portfolio-voice-agent

# Server-only: shared secret for the n8n voice webhook
# Leave empty until you fill it in yourself.
VOICE_WEBHOOK_SECRET=

# fill with the Google Search Console HTML tag verification code
GOOGLE_SITE_VERIFICATION=
